# Required outside local development. Do not commit a real .env file.
NODE_ENV=production

# 48+ random bytes encoded as base64/base64url. Rotate if it is ever exposed.
JWT_SECRET=replace_with_a_long_random_secret

# Exactly 32 random bytes encoded as base64/base64url, or 64 hexadecimal chars.
# This encrypts Script.source and ScriptVersion.source at rest. Back it up safely:
# losing it makes existing encrypted source unrecoverable.
SCRIPT_SOURCE_KEY=replace_with_32_random_bytes_encoded_as_base64url

# Canonical public origin, used to generate every public loadstring.
PUBLIC_BASE_URL=https://example.com

# Comma-separated browser origins that may send credentialed API requests.
# The PUBLIC_BASE_URL is allowed automatically; add a distinct dashboard only if needed.
CORS_ORIGINS=https://dashboard.example.com

MONGO_URI=mongodb+srv://...
DISCORD_CLIENT_SECRET=
OPENROUTER_API_KEY=
